{
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "swift.disableSwiftPackageManagerIntegration": false,
  "swift.ignoreSwiftVersionFile": false,
  "search.exclude": {
    "**/.build": true,
    "**/build": true,
    "**/.claude/worktrees": true
  },
  "todo-tree.filtering.excludeGlobs": [
    "**/.build/**",
    "**/build/**",
    "**/.claude/worktrees/**"
  ],
  "files.watcherExclude": {
    "**/.build/**": true,
    "**/build/**": true,
    "**/.claude/worktrees/**": true
  },
  "files.exclude": {
    "**/.build": true,
    "**/build": true
  }
}
