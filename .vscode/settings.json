{
  "[swift]": {
    "editor.defaultFormatter": "swiftlang.swift-vscode",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true
  },
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features",
    "editor.formatOnSave": true
  },
  "swift.disableSwiftPackageManagerIntegration": false,
  "swift.ignoreSwiftVersionFile": false,
  "chat.agent.sandbox.allowNetwork": true,
  "chat.agent.sandbox.allowAutoApprove": true,
  "chat.agentHost.shellTool.initScript.enabled": true,
  "github.copilot.chat.codesearch.enabled": true,
  "chat.useNestedAgentsMdFiles": true,
  "search.exclude": {
    "**/.build": true,
    "**/build": true,
    "**/.claude/worktrees": true
  },
  "todo-tree.filtering.excludeGlobs": [
    "**/.build/**",
    "**/build/**",
    "**/.claude/worktrees/**"
  ],
  "files.watcherExclude": {
    "**/.build/**": true,
    "**/build/**": true,
    "**/.claude/worktrees/**": true
  },
  "files.exclude": {
    "**/.build": true,
    "**/build": true
  }
}
