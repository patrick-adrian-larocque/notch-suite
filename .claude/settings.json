{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // empty' | { read -r f; case \"$f\" in */NotchSuite.xcodeproj/*|*/Package.resolved) printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PreToolUse\",\"permissionDecision\":\"deny\",\"permissionDecisionReason\":\"Generated, gitignored file. Change project.yml or Package.swift and regenerate instead.\"}}';; esac; }"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '[.tool_name, (.tool_response.type // \"\"), (.tool_input.file_path // \"\")] | join(\"|\")' | { IFS='|' read -r t ty f; m=; case \"$f\" in */project.yml) m=1;; */App/*.swift) [ \"$t\" = Write ] && [ \"$ty\" = create ] && m=1;; esac; [ -n \"$m\" ] && printf '%s\\n' '{\"hookSpecificOutput\":{\"hookEventName\":\"PostToolUse\",\"additionalContext\":\"project.yml or the App/ file set changed: run xcodegen generate before building the Xcode project.\"}}'; true; }"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_response.filePath // .tool_input.file_path' | { read -r f; case \"$f\" in *.swift) swift format format --in-place \"$f\";; esac; } 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(swift build)",
      "Bash(swift build *)",
      "Bash(swift test)",
      "Bash(swift test *)",
      "Bash(swift format)",
      "Bash(swift format *)",
      "Bash(xcodegen *)",
      "Bash(xcodebuild build -project NotchSuite.xcodeproj *)",
      "mcp__xcode-tools__XcodeListSchemes",
      "mcp__xcode-tools__XcodeRefreshCodeIssuesInFile",
      "mcp__xcode-tools__XcodeRead",
      "mcp__xcode-tools__XcodeGrep",
      "mcp__xcode-tools__XcodeGlob",
      "mcp__xcode-tools__XcodeLS",
      "mcp__xcode-tools__GetBuildLog",
      "mcp__xcode-tools__BuildProject",
      "mcp__xcode-tools__RunAllTests",
      "mcp__xcode-tools__RunSomeTests",
      "mcp__xcode-tools__XcodeListTargets",
      "mcp__xcode-tools__XcodeListWorkspaces",
      "mcp__xcode-tools__GetTestList",
      "mcp__xcode-tools__GetTargetBuildSettings",
      "mcp__xcode-tools__GetConsoleOutput",
      "mcp__xcode-tools__DocumentationSearch",
      "mcp__xcode-tools__RenderPreview",
      "mcp__xcode-tools__XcodeCloseWorkspace",
      "mcp__xcode-tools__XcodeSwitchScheme"
    ],
    "ask": [
      "mcp__xcode-tools__XcodeOpenWorkspace",
      "mcp__xcode-tools__RunProject",
      "mcp__xcode-tools__StopProject",
      "mcp__xcode-tools__RunCodeSnippet",
      "mcp__xcode-tools__InvokeDebuggerCommand",
      "mcp__xcode-tools__DeviceInteractionStartSession",
      "mcp__xcode-tools__DeviceInteractionStartWorkspaceSession",
      "mcp__xcode-tools__DeviceInteractionInstallAndRun",
      "mcp__xcode-tools__DeviceInteractionSynthesize",
      "mcp__xcode-tools__DeviceInteractionEndSession"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.p12)",
      "Read(./**/*.mobileprovision)",
      "Read(./**/*.cer)",
      "mcp__xcode-tools__XcodeNewProject",
      "mcp__xcode-tools__XcodeNewTarget",
      "mcp__xcode-tools__UpdateTargetBuildSetting",
      "mcp__xcode-tools__UpdateFileCompilerFlags",
      "mcp__xcode-tools__AddEntitlement",
      "mcp__xcode-tools__AddInfoPlist",
      "mcp__xcode-tools__LocalizationPlanner",
      "mcp__xcode-tools__XcodeMakeDir",
      "mcp__xcode-tools__XcodeMV",
      "mcp__xcode-tools__XcodeRM",
      "mcp__xcode-tools__XcodeWrite",
      "mcp__xcode-tools__XcodeUpdate",
      "mcp__xcode-tools__StringCatalogEdit"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
